types = {
  px: 0,
  dp: 1,
  sp: 2,
  pt: 3,
  'in': 4,
  mm: 5
}


function as_numeric(value)
  result = pcall(function(data) return Number(data) end, value)
  if result[0] then
    return result[1]
  else
    return 0
  end
end

function check_type(value)
  if type(value) != 'String' then
    return null
  end
  result = value.match('^(%-?%d+)(%a%a)$')
  if result == null then
    return null
  end
  n = Number(result[1])
  ty = types.get(result[2])
  if n == null or ty == null then
    return null
  end
  return { n, ty }
end

function check_percent(value)
  if type(value) != 'String' then
    return null
  end
  result = value.match('^(%-?[%.%d]+)%%([wh])$')
  if result == null then
    return null
  end
  n = Number(result[1])
  if n == null then
    return null
  end
  if result[2] == 'w' then
    return n * W / 100
  end
  if result[2] == 'h' then
    return n * H / 100
  end
  return null
end

function parse_size(value)
  if type(value) == 'Number' then
    return value
  end
  if type(value) != 'String' then
    return value
  end
  if value == 'match_parent' or value == 'fill_parent' then
    return -1
  end
  if value == 'wrap_content' or value == 'wrap' then
    return -2
  end
  percent = check_percent(value)
  if percent != null then
    return percent
  end
  typed = check_type(value)
  if typed != null then
    return TypedValue.applyDimension(typed[1], typed[0], dm)
  end
  if value.endswith('dp') then
    num_str = value.split('dp')[0]
    num = as_numeric(num_str)
    return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, num, dm)
  end
  if value.endswith('sp') then
    num_str = value.split('sp')[0]
    num = as_numeric(num_str)
    return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, num, dm)
  end
  if value.endswith('px') then
    num_str = value.split('px')[0]
    return as_numeric(num_str)
  end
  return as_numeric(value)
end

function parse_color(value)
  if type(value) == 'Number' then
    return value
  end
  if type(value) == 'String' and value.startswith('#') then
    return Color.parseColor(value)
  end
  return value
end

function split_flags(value)
  parts = []
  if type(value) != 'String' then
    return parts
  end
  if value.indexOf('|') == -1 then
    parts.append(value)
    return parts
  end
  i = 0
  curr = ''
  while i < value.length do
    ch = value[i]
    if ch == '|' then
      if curr.length > 0 then parts.append(curr) end
      curr = ''
    else
      curr = curr + ch
    end
    i = i + 1
  end
  if curr.length > 0 then parts.append(curr) end
  return parts
end

function parse_flags(value, map)
  if type(value) == 'Number' then
    return value
  end
  parts = split_flags(value)
  if parts.length == 0 then
    return null
  end
  out = 0
  i = 0
  while i < parts.length do
    key = parts[i]
    flag = map.get(key)
    if flag == null then
      return null
    end
    out = out | flag
    i = i + 1
  end
  return out
end

function get_identifier(name)
  return context.getResources().getIdentifier(name, null, null)
end

function checkattr(name)
  if name == null then
    return null
  end
  result = pcall(function(k) return AndroidR.attr[k] end, name)
  if result[0] then
    return result[1]
  end
  return null
end

function parse_gravity(value)
  if type(value) != 'String' then
    return value
  end
  if value == 'center' then return 17 end
  if value == 'center_horizontal' then return 1 end
  if value == 'center_vertical' then return 16 end
  if value == 'left' then return 3 end
  if value == 'right' then return 5 end
  if value == 'top' then return 48 end
  if value == 'bottom' then return 80 end
  if value == 'start' then return 8388611 end
  if value == 'end' then return 8388613 end
  return null
end

function set_text_style(view, style)
  if style == 'bold' then
    view.setTypeface(Typeface.DEFAULT_BOLD)
    return
  end
  if style == 'italic' then
    view.setTypeface(Typeface.defaultFromStyle(Typeface.ITALIC))
    return
  end
  if style == 'bold_italic' then
    view.setTypeface(Typeface.defaultFromStyle(Typeface.BOLD_ITALIC))
    return
  end
end

function checkint(value)
  if type(value) != 'String' then
    return null
  end
  parts = value.split('|')
  if parts == null or parts.length == 0 then
    return null
  end
  out = 0
  i = 0
  while i < parts.length do
    v = toint.get(parts[i])
    if v == null then
      return null
    end
    out = out | v
    i = i + 1
  end
  return out
end

function check_value(value)
  if type(value) == 'String' then
    if value == 'true' then
      return true
    end
    if value == 'false' then
      return false
    end
    direct = toint.get(value)
    if direct != null then
      return direct
    end
    flags = checkint(value)
    if flags != null then
      return flags
    end
    percent = check_percent(value)
    if percent != null then
      return percent
    end
  end
  num = pcall(function(v) return Number(v) end, value)
  if num[0] then
    return num[1]
  end
  return value
end

function capitalize_first(key)
  if key == null or key.length == 0 then
    return key
  end
  return key.sub(0, 1).upper() + key.sub(1)
end

function new_layout_params(parent, width, height)
  if parent != null and java.instanceof(parent, LinearLayout) then
    return LinearLayoutParams(width, height)
  end
  if parent != null and java.instanceof(parent, RelativeLayout) then
    return RelativeLayoutParams(width, height)
  end
  return ViewGroup.LayoutParams(width, height)
end

function collect_children(node, start_index)
  if start_index == null then
    return null
  end
  children = []
  i = start_index
  while true do
    child = node.get(i)
    if child == null then
      break
    end
    children.append(child)
    i = i + 1
  end
  if children.length == 0 then
    return null
  end
  return children
end

function apply_layout(view, params, node)
  layout_weight = node.get('layout_weight')
  if layout_weight != null and java.instanceof(params, LinearLayoutParams) then
    java.setField(params, 'weight', layout_weight)
  end

  layout_gravity = node.get('layout_gravity')
  if layout_gravity != null and java.instanceof(params, LinearLayoutParams) then
    g = parse_gravity(layout_gravity)
    if g != null then
      java.setField(params, 'gravity', g)
    end
  end

  layout_margin = node.get('layout_margin')
  layout_margin_start = node.get('layout_marginStart')
  layout_margin_end = node.get('layout_marginEnd')
  layout_margin_bottom = node.get('layout_marginBottom')
  layout_margin_top = node.get('layout_marginTop')
  layout_margin_left = node.get('layout_marginLeft')
  layout_margin_right = node.get('layout_marginRight')
  has_margin = layout_margin != null or layout_margin_bottom != null or layout_margin_top != null or layout_margin_left != null or layout_margin_right != null
  if has_margin then
    left = parse_size(layout_margin_left or layout_margin or 0)
    top = parse_size(layout_margin_top or layout_margin or 0)
    right = parse_size(layout_margin_right or layout_margin or 0)
    bottom = parse_size(layout_margin_bottom or layout_margin or 0)
    params.setMargins(left, top, right, bottom)
  end
  if layout_margin_start != null then
    params.setMarginStart(parse_size(layout_margin_start))
  end
  if layout_margin_end != null then
    params.setMarginEnd(parse_size(layout_margin_end))
  end

  if java.instanceof(params, RelativeLayoutParams) then
    i = 0
    keys = node.keys
    while i < keys.length do
      key = keys[i]
      rule = RelativeLayoutRule.get(key)
      if rule != null then
        value = node.get(key)
        if value == true then
          params.addRule(rule)
        else
          target_id = idmap.get(value)
          if target_id != null then
            params.addRule(rule, target_id)
          end
        end
      end
      i = i + 1
    end
  end

  view.setLayoutParams(params)
end

function apply_attrs(view, node)
  orientation = node.get('orientation')
  if orientation != null and java.instanceof(view, LinearLayout) then
    if orientation == 'vertical' then
      view.setOrientation(1)
    end
    if orientation == 'horizontal' then
      view.setOrientation(0)
    end
  end

  padding = node.get('padding')
  padding_left = node.get('paddingLeft')
  padding_top = node.get('paddingTop')
  padding_right = node.get('paddingRight')
  padding_bottom = node.get('paddingBottom')
  padding_start = node.get('paddingStart')
  padding_end = node.get('paddingEnd')

  has_padding = padding != null or padding_left != null or padding_top != null or padding_right != null or padding_bottom != null
  has_padding_relative = padding_start != null or padding_end != null

  if has_padding then
    left = parse_size(padding_left or padding or 0)
    top = parse_size(padding_top or padding or 0)
    right = parse_size(padding_right or padding or 0)
    bottom = parse_size(padding_bottom or padding or 0)
    view.setPadding(left, top, right, bottom)
  end
  if has_padding_relative then
    left = parse_size(padding_start or padding or 0)
    top = parse_size(padding_top or padding or 0)
    right = parse_size(padding_end or padding or 0)
    bottom = parse_size(padding_bottom or padding or 0)
    view.setPaddingRelative(left, top, right, bottom)
  end

  text = node.get('text')
  if text != null then
    view.setText(text)
  end

  text_size = node.get('textSize')
  if text_size != null then
    size = parse_size(text_size)
    view.setTextSize(TypedValue.COMPLEX_UNIT_PX, size)
  end

  text_style = node.get('textStyle')
  if text_style != null then
    set_text_style(view, text_style)
  end

  hint = node.get('hint')
  if hint != null then
    view.setHint(hint)
  end

  if node.get('singleLine') == true then
    view.setSingleLine(true)
  end

  checked = node.get('checked')
  if checked != null then
    view.setChecked(checked == true)
  end

  background_color = node.get('backgroundColor')
  if background_color != null then
    view.setBackgroundColor(parse_color(background_color))
  end

  text_color = node.get('textColor')
  if text_color != null then
    view.setTextColor(parse_color(text_color))
  end

  text_appearance = node.get('textAppearance')
  if text_appearance != null then
    if type(text_appearance) == 'String' and text_appearance.startswith('?') then
      res_id = get_identifier(text_appearance.sub(1))
      if res_id != 0 then
        view.setTextAppearance(context, res_id)
      end
    end
  end

  auto_link = node.get('autoLink')
  if auto_link != null then
    mask = parse_flags(auto_link, AutoLinkFlag)
    if mask != null then
      view.setAutoLinkMask(mask)
    end
  end

  input_type = node.get('inputType')
  if input_type != null then
    mask = parse_flags(input_type, InputTypeFlag)
    if mask != null then
      view.setInputType(mask)
    end
  end

  ime_options = node.get('imeOptions')
  if ime_options != null then
    mask = parse_flags(ime_options, ImeOptionFlag)
    if mask != null then
      view.setImeOptions(mask)
    end
  end

  password = node.get('password')
  if password == true then
    view.setInputType(0x81)
  end

  background = node.get('background')
  if background != null then
    if type(background) == 'String' and background.startswith('#') then
      view.setBackgroundColor(parse_color(background))
    end
    if type(background) == 'String' and background.startswith('?') then
      res_id = get_identifier(background.sub(1))
      if res_id != 0 then
        view.setBackgroundResource(res_id)
      end
    end
    if type(background) == 'Number' then
      view.setBackgroundColor(background)
    end
  end

  src = node.get('src')
  if src != null and java.instanceof(view, ImageView) then
    if type(src) == 'String' and src.startswith('?') then
      res_id = get_identifier(src.sub(1))
      if res_id != 0 then
        view.setImageResource(res_id)
      end
    end
    if type(src) == 'Number' then
      view.setImageResource(src)
    end
  end

  scale_type = node.get('scaleType')
  if scale_type != null and java.instanceof(view, ImageView) then
    st = ScaleTypeMap.get(scale_type)
    if st != null then
      view.setScaleType(st)
    end
  end

  visibility = node.get('visibility')
  if visibility != null then
    if visibility == 'visible' then view.setVisibility(0) end
    if visibility == 'invisible' then view.setVisibility(4) end
    if visibility == 'gone' then view.setVisibility(8) end
  end

  text_alignment = node.get('textAlignment')
  if text_alignment != null then
    if text_alignment == 'inherit' then view.setTextAlignment(0) end
    if text_alignment == 'gravity' then view.setTextAlignment(1) end
    if text_alignment == 'textStart' then view.setTextAlignment(2) end
    if text_alignment == 'textEnd' then view.setTextAlignment(3) end
    if text_alignment == 'textCenter' then view.setTextAlignment(4) end
    if text_alignment == 'viewStart' then view.setTextAlignment(5) end
    if text_alignment == 'viewEnd' then view.setTextAlignment(6) end
  end

  ellipsize = node.get('ellipsize')
  if ellipsize != null then
    view.setEllipsize(TruncateAt[ellipsize.upper()])
  end

  on_click = node.get('onClick')
  if on_click != null then
    view.setClickable(true)
    if type(on_click) == "Closure" then
      view.setOnClickListener(View.OnClickListener({
        onClick: on_click
      }))
    else
      view.setOnClickListener(on_click)
    end
  end

  items = node.get('items')
  if items != null then
    list = java.new('java.util.ArrayList', items)
    adapter = ArrayAdapter(context, AndroidRLayout.simple_list_item_1, list)
    view.setAdapter(adapter)
  end
end

function apply_auto_attrs(view, node)
  keys = node.keys
  if keys == null then
    return
  end
  i = 0
  while i < keys.length do
    key = keys[i]
    if type(key) == 'String' then
      if key != 'type' and key != 'id' and key != 'style' and !key.startswith('layout_') and !key.startswith('padding') and key != 'orientation' and key != 'text' and key != 'textSize' and key != 'textStyle' and key != 'textColor' and key != 'textAppearance' and key != 'hint' and key != 'singleLine' and key != 'checked' and key != 'backgroundColor' and key != 'background' and key != 'src' and key != 'scaleType' and key != 'visibility' and key != 'textAlignment' and key != 'ellipsize' and key != 'autoLink' and key != 'inputType' and key != 'imeOptions' and key != 'password' and key != 'onClick' and key != 'items' then
        value = node.get(key)
        setter = 'set' + capitalize_first(key)
        called = pcall(function(v, s, val)
          return java.call(v, s, val)
        end, view, setter, check_value(value))
        if !called[0] then
          assert(false, 'loadlayout: setter call failed: ' + setter + ' key=' + key)
          return
        end
      end
    end
    i = i + 1
  end
end

function create_view(node, parent)
  node_type = node.get('type')
  child_start = null
  if node_type == null then
    node_type = node.get(0)
    if node_type != null then
      child_start = 1
    else
      node_type = node.get(1)
      if node_type != null then
        child_start = 2
      end
    end
  else
    if node.get(0) != null then
      child_start = 0
    else
      if node.get(1) != null then
        child_start = 1
      end
    end
  end
  if node_type == null then
    assert(false, 'loadlayout: missing view type')
  end
  style_id = null
  view = null
  style_value = node.get('style')
  if style_value != null and type(style_value) == 'String' then
    if style_value.startswith('?') then
      style_id = get_identifier(style_value.sub(1))
    else
      style_id = checkattr(style_value)
    end
  end
  if style_id != null and style_id != 0 then
    view = node_type(context, null, style_id)
  else
    view = node_type(context)
  end
  width = parse_size(node.get('layout_width') or -2)
  height = parse_size(node.get('layout_height') or -2)
  params = new_layout_params(parent, width, height)
  apply_layout(view, params, node)
  apply_attrs(view, node)
  apply_auto_attrs(view, node)

  node_id = node.get('id')
  if node_id != null then
    next_id = next_id + 1
    view.setId(next_id)
    ids.setattr(node_id, view)
    idmap.setattr(node_id, next_id)
    target_module.define(node_id, view)
  end

  children = collect_children(node, child_start)
  if children != null then
    i = 0
    while i < children.length do
      child = children[i]
      child_view = create_view(child, view)
      view.addView(child_view)
      i = i + 1
    end
  end

  return view
end

function loadlayout(activity, node)
  assert(java.instanceof(activity, Context), 'loadlayout: activity is null')
  ids = {}
  idmap = {}
  next_id = 0x7f000000
  target_module = activity.getModule()
  assert(target_module is Module, 'loadlayout: target module isnt a module')
  context = activity

  dm = context.getResources().getDisplayMetrics()
  wm = context.getSystemService(Context.WINDOW_SERVICE)
  out = DisplayMetrics()
  wm.getDefaultDisplay().getMetrics(out)
  W = out.widthPixels
  H = out.heightPixels
  target_module.define('ids', ids)
  target_module.define('idmap', idmap)
  return create_view(node, null)
end


