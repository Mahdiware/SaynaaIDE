class LoadLayout
  function _init(context)
    this.context = context
    
    this.dm = this.context.getResources().getDisplayMetrics()
    wm = this.context.getSystemService(Context.WINDOW_SERVICE)
    out = DisplayMetrics()
    wm.getDefaultDisplay().getMetrics(out)
    this.WIDTH = out.widthPixels
    this.HEIGHT = out.heightPixels
    
    this.saynaadir = java.saynaadir
    
    this.module = null
    this.next_id = 0x7f000000
    this.default_nodes = {}
    this.ids = {}
    this.idmap = {}
  end
  
  function setModule(module)
    this.module = module
  end

  function getObjects()
    return this.ids
  end
  
  function toast(msg)
	Toast.makeText(this.context, msg, Toast.LENGTH_SHORT).show()
  end

  function as_numeric(value)
    result = pcall(function(numb) return Number(numb) end, value)
    if result[0] then
      return result[1]
    else
      return 0
    end
  end

  function check_type(value)
    if not value is String then
      return null
    end
    result = re.extract('^(-?\d+)([A-Za-z]{2})$', value)
    if result == null then
      return null
    end
    n = Number(result[1])
    ty = types.get(result[2])
    if n == null or ty == null then
      return null
    end
    return { n, ty }
  end
  
  function normalizeColor(color)
    // If alpha is missing (0xRRGGBB), add FF alpha.
    if ((color & 0xFF000000) == 0)
      color |= 0xFF000000;
    end
    return color;
  end
  
  function check_percent(value)
    if not value is String then
      return null
    end
    result = re.extract('^(-?[\.\d]+)%([wh])$', value)
    if result == null then
      return null
    end
    n = Number(result[1])
    if n == null then
      return null
    end
    if result[2] == 'w' then
      return n * this.WIDTH / 100
    end
    if result[2] == 'h' then
      return n * this.HEIGHT / 100
    end
    return null
  end
  
  function parse_size(value)
    if value is Number then
      return value
    end
    if not value is String then
      return value
    end
    if value == 'match_parent' or value == 'fill_parent' then
      return -1
    end
    if value == 'wrap_content' or value == 'wrap' then
      return -2
    end
    percent = this.check_percent(value)
    if percent != null then
      return percent
    end
    typed = this.check_type(value)
    if typed != null then
      return TypedValue.applyDimension(typed[1], typed[0], this.dm)
    end
    if value.endswith('dp') then
      num_str = value.split('dp')[0]
      num = this.as_numeric(num_str)
      return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, num, this.dm)
    end
    if value.endswith('sp') then
      num_str = value.split('sp')[0]
      num = this.as_numeric(num_str)
      return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, num, this.dm)
    end
    if value.endswith('px') then
      num_str = value.split('px')[0]
      return this.as_numeric(num_str)
    end
    return this.as_numeric(value)
  end
  
  function parse_color(value)
    if value is Number then
      return this.normalizeColor(value)
    end
    if value is String and value.startswith('#') then
      return Color.parseColor(value)
    end
    return value
  end
  
  function split_flags(value)
    parts = []
    if not value is String then
      return parts
    end
    return value.split('|')
  end
  
  function parse_flags(value, map)
    if value is Number then
      return value
    end
    parts = this.split_flags(value)
    if parts.length == 0 then
      return null
    end
    out = 0
    i = 0
    while i < parts.length do
      key = parts[i]
      flag = map.get(key)
      if flag == null then
        return null
      end
      out = out | flag
      i = i + 1
    end
    return out
  end
  
  function get_identifier(name)
    return this.context.getResources().getIdentifier(name, null, null)
  end
  
  function checkattr(name)
    if name == null then
      return null
    end
    // FIXME
    result = pcall(function(k) return AndroidR.attr[k] end, name)
    if result[0] then
      return result[1]
    end
    return null
  end
  
  function parse_gravity(value)
      flags = value.split('|')
      result = 0
      for flag in flags do
          flag = flag.strip()
          if gravity.has(flag) then
              result = result | gravity.get(flag)
          end
      end
      return result
  end
  
  function set_text_style(view, style)
    if style == 'bold' then
      view.setTypeface(Typeface.DEFAULT_BOLD)
      return
    end
    if style == 'italic' then
      view.setTypeface(Typeface.defaultFromStyle(Typeface.ITALIC))
      return
    end
    if style == 'bold_italic' then
      view.setTypeface(Typeface.defaultFromStyle(Typeface.BOLD_ITALIC))
      return
    end
  end
  
  function checkint(value)
    if not value is String then
      return null
    end
    parts = value.split('|')
    if parts == null or parts.length == 0 then
      return null
    end
    out = 0
    i = 0
    while i < parts.length do
      v = toint.get(parts[i])
      if v == null then
        return null
      end
      out = out | v
      i = i + 1
    end
    return out
  end
  
  function check_value(value)
    if value is String then
      if value == 'true' then
        return true
      end
      if value == 'false' then
        return false
      end
      direct = toint.get(value)
      if direct != null then
        return direct
      end
      flags = this.checkint(value)
      if flags != null then
        return flags
      end
      percent = this.check_percent(value)
      if percent != null then
        return percent
      end
    end
    if value is Bool then
      return value
    end
    num = pcall(function(v) return Number(v) end, value)
    if num[0] then
      return num[1]
    end
    return value
  end
  
  function capitalize_first(key)
    if key == null or key.length == 0 then
      return key
    end
    return key.sub(0, 1).upper() + key.sub(1)
  end
  
  function new_layout_params(parent, width, height)
    classname = java.getClassName(parent) // e.g: android.widget.LinearLayout
    paramsClass = java.bindClass(str(classname) + '$LayoutParams')
  
    if paramsClass != null then
      return paramsClass(width, height)
    end
  
    return ViewGroup.LayoutParams(width, height)
  end
  
  function collect_children(node)
    children = []
    i = 1
    while true do
      child = node.get(i)
      if child == null then
        break
      end
      children.append(child)
      i = i + 1
    end
    if children.length == 0 then
      return null
    end

    return children
  end
  
  function apply_layout(view, params, node)
    layout_weight = node.get('layout_weight')
    if layout_weight != null and java.instanceof(params, LinearLayoutParams) then
      params.weight = this.check_value(layout_weight)
    end
  
    layout_gravity = node.get('layout_gravity')
  
    if layout_gravity != null then
      g = this.parse_gravity(layout_gravity)
    
      if g != null then
          params.gravity = g
      end
    end
  
    layout_margin = node.get('layout_margin')
    layout_margin_start = node.get('layout_marginStart')
    layout_margin_end = node.get('layout_marginEnd')
    layout_margin_bottom = node.get('layout_marginBottom')
    layout_margin_top = node.get('layout_marginTop')
    layout_margin_left = node.get('layout_marginLeft')
    layout_margin_right = node.get('layout_marginRight')
    has_margin = layout_margin != null or layout_margin_bottom != null or layout_margin_top != null or layout_margin_left != null or layout_margin_right != null
    if has_margin then
      left = this.parse_size(layout_margin_left or layout_margin or 0)
      top = this.parse_size(layout_margin_top or layout_margin or 0)
      right = this.parse_size(layout_margin_right or layout_margin or 0)
      bottom = this.parse_size(layout_margin_bottom or layout_margin or 0)
      params.setMargins(left, top, right, bottom)
    end
    if layout_margin_start != null then
      params.setMarginStart(this.parse_size(layout_margin_start))
    end
    if layout_margin_end != null then
      params.setMarginEnd(this.parse_size(layout_margin_end))
    end
  
    if java.instanceof(params, RelativeLayoutParams) then
      i = 0
      keys = node.keys
      while i < keys.length do
        key = keys[i]
        rule = RelativeLayoutRule.get(key)
        if rule != null then
          value = node.get(key)
          if value == true then
            params.addRule(rule)
          else
            target_id = this.idmap.get(value)
            if target_id != null then
              params.addRule(rule, target_id)
            end
          end
        end
        i = i + 1
      end
    end
  
    view.setLayoutParams(params)
  end
  
  
  function apply_image(view, src)
    if src is String and src.startswith('?') then
      res_id = this.get_identifier(src.sub(1))
      if res_id != 0 then
        view.setImageResource(res_id)
      end
    else
      // Load image from saynaadir + file path
      bitmap = BitmapFactory.decodeFile(this.saynaadir + "/" + src)
      if (bitmap != null)
        // Convert to drawable
        drawable = BitmapDrawable(this.context.getResources(), bitmap)
        view.setImageDrawable(drawable)
      else
        // Load image from file path
        bitmap = BitmapFactory.decodeFile(src)
        if (bitmap != null)
          // Convert to drawable
          drawable = BitmapDrawable(this.context.getResources(), bitmap)
          view.setImageDrawable(drawable)
        end
      end
    end
  
    if src is Number then
      view.setImageResource(src)
    end
  
  end
  
  function apply_attrs(view, node)
    orientation = node.get('orientation')
    if orientation != null and java.instanceof(view, LinearLayout) then
      if orientation == 'vertical' then
        view.setOrientation(1)
      end
      if orientation == 'horizontal' then
        view.setOrientation(0)
      end
    end
  
    padding = node.get('padding')
    padding_left = node.get('paddingLeft')
    padding_top = node.get('paddingTop')
    padding_right = node.get('paddingRight')
    padding_bottom = node.get('paddingBottom')
    padding_start = node.get('paddingStart')
    padding_end = node.get('paddingEnd')
  
    has_padding = padding != null or padding_left != null or padding_top != null or padding_right != null or padding_bottom != null
    has_padding_relative = padding_start != null or padding_end != null
  
    if has_padding then
      left = this.parse_size(padding_left or padding or 0)
      top = this.parse_size(padding_top or padding or 0)
      right = this.parse_size(padding_right or padding or 0)
      bottom = this.parse_size(padding_bottom or padding or 0)
      view.setPadding(left, top, right, bottom)
    end
    if has_padding_relative then
      left = this.parse_size(padding_start or padding or 0)
      top = this.parse_size(padding_top or padding or 0)
      right = this.parse_size(padding_end or padding or 0)
      bottom = this.parse_size(padding_bottom or padding or 0)
      view.setPaddingRelative(left, top, right, bottom)
    end
  
    text = node.get('text')
    if text != null then
      view.setText(text)
    end
  
    text_size = node.get('textSize')
    if text_size != null then
      size = this.parse_size(text_size)
      view.setTextSize(TypedValue.COMPLEX_UNIT_PX, size)
    end
  
    text_style = node.get('textStyle')
    if text_style != null then
      this.set_text_style(view, text_style)
    end
  
    hint = node.get('hint')
    if hint != null then
      view.setHint(hint)
    end
  
    if node.get('singleLine') == true then
      view.setSingleLine(true)
    end
  
    checked = node.get('checked')
    if checked != null then
      view.setChecked(checked == true)
    end
  
    background_color = node.get('backgroundColor')
    if background_color != null then
      view.setBackgroundColor(this.parse_color(background_color))
    end
  
    text_color = node.get('textColor')
    if text_color != null then
      view.setTextColor(this.parse_color(text_color))
    end
  
    text_appearance = node.get('textAppearance')
    if text_appearance != null then
      if text_appearance is String and text_appearance.startswith('?') then
        res_id = this.get_identifier(text_appearance.sub(1))
        if res_id != 0 then
          view.setTextAppearance(this.context, res_id)
        end
      end
    end
  
    auto_link = node.get('autoLink')
    if auto_link != null then
      mask = this.parse_flags(auto_link, AutoLinkFlag)
      if mask != null then
        view.setAutoLinkMask(mask)
      end
    end
  
    input_type = node.get('inputType')
    if input_type != null then
      mask = this.parse_flags(input_type, InputTypeFlag)
      if mask != null then
        view.setInputType(mask)
      end
    end
  
    ime_options = node.get('imeOptions')
    if ime_options != null then
      mask = this.parse_flags(ime_options, ImeOptionFlag)
      if mask != null then
        view.setImeOptions(mask)
      end
    end
  
    password = node.get('password')
    if password == true then
      view.setInputType(0x81)
    end
  
    background = node.get('background')
    if background != null then
      if background is String and background.startswith('#') then
        view.setBackgroundColor(this.parse_color(background))
      end
      if background is String and background.startswith('?') then
        res_id = this.get_identifier(background.sub(1))
        if res_id != 0 then
          view.setBackgroundResource(res_id)
        end
      end
      if background is Number then
        view.setBackgroundColor(background)
      end
      if type(background) == 'JavaObject' then
        view.setBackground(background)
      end
    end
  
    filter = node.get('colorFilter')
    if filter != null then
      view.setColorFilter(this.parse_color(filter))
    end
  
    src = node.get('src')
    if src != null and java.instanceof(view, ImageView) then
      this.apply_image(view, src)
    end
  
    scale_type = node.get('scaleType')
    if scale_type != null and java.instanceof(view, ImageView) then
      st = ScaleTypeMap.get(scale_type)
      if st != null then
        view.setScaleType(st)
      end
    end
  
    visibility = node.get('visibility')
    if visibility != null then
      if visibility == 'visible' then view.setVisibility(0) end
      if visibility == 'invisible' then
        debug("called invisible node -> $node")
        view.setVisibility(4)
      end
      if visibility == 'gone' then view.setVisibility(8) end
    end
  
    text_alignment = node.get('textAlignment')
    if text_alignment != null then
      if text_alignment == 'inherit' then view.setTextAlignment(0) end
      if text_alignment == 'gravity' then view.setTextAlignment(1) end
      if text_alignment == 'textStart' then view.setTextAlignment(2) end
      if text_alignment == 'textEnd' then view.setTextAlignment(3) end
      if text_alignment == 'textCenter' then view.setTextAlignment(4) end
      if text_alignment == 'viewStart' then view.setTextAlignment(5) end
      if text_alignment == 'viewEnd' then view.setTextAlignment(6) end
    end
  
    ellipsize = node.get('ellipsize')
    if ellipsize != null then
      view.setEllipsize(TruncateAt.valueOf(ellipsize.upper()))
    end
  
    on_click = node.get('onClick')
    if on_click != null then
      view.setClickable(true)
      if on_click is Closure then
        view.setOnClickListener(View.OnClickListener({
          onClick: on_click
        }))
      else
        view.setOnClickListener(on_click)
      end
    end
  
    items = node.get('items')
    if items != null then
      adapter = ArrayAdapter(this.context, AndroidRLayout.simple_list_item_1, items)
      view.setAdapter(adapter)
    end
  
    node_id = node.get('id')

  end
  
  function apply_auto_attrs(view, node)
    keys = node.keys
    if keys == null then
      return
    end

    i = 0
    while i < keys.length do
      key = keys[i]
      if key is String then
        if key != 'id' and key != 'style' and !key.startswith('layout_') and !key.startswith('padding') and key != 'orientation' and key != 'text' and key != 'textSize' and key != 'textStyle' and key != 'textColor' and key != 'textAppearance' and key != 'hint' and key != 'singleLine' and key != 'checked' and key != 'backgroundColor' and key != 'background' and key != 'src' and key != 'scaleType' and key != 'visibility' and key != 'textAlignment' and key != 'ellipsize' and key != 'autoLink' and key != 'inputType' and key != 'imeOptions' and key != 'password' and key != 'onClick' and key != 'items' then
          value = node.get(key)
          setter = 'set' + this.capitalize_first(key)
          called = pcall(function(v, s, val)
            return java.call(v, s, val)
          end, view, setter, this.check_value(value))
          if !called[0] then
            assert(false, 'loadlayout: setter call failed: ' + setter + ' key=' + key)
            return
          end
        end
      end
      i = i + 1
    end
  end
  
  function createView(node, parent)
    if not (node is Map) then
      assert(false, 'loadlayout node: expected Map and got ' .. type(node) .. package.path)
    end

    node_type = node.get(0)

    if node_type == null then
      assert(false, 'loadlayout: missing view type')
    end
    style_id = null
    view = null
    style_value = node.get('style')
    if style_value != null and style_value is String then
      if style_value.startswith('?') then
        style_id = this.get_identifier(style_value.sub(1))
      end
    end
    if style_id != null and style_id != 0 then
      view = node_type(this.context, null, style_id)
    else
      view = node_type(this.context)
    end
    width = this.parse_size(node.get('layout_width') or -2)
    height = this.parse_size(node.get('layout_height') or -2)
    params = this.new_layout_params(parent, width, height)
    this.apply_layout(view, params, node)
    this.apply_attrs(view, node)
    this.apply_auto_attrs(view, node)
  
    node_id = node.get('id')
    if node_id != null then
      this.next_id = this.next_id + 1
      view.setId(this.next_id)
      this.ids.setattr(node_id, view)
      this.idmap.setattr(node_id, this.next_id)
      
      this.default_nodes.setattr(node_id, node) // ADD THIS: Save the original layout blueprint
      
      if this.module is Module then
        this.module.define(node_id, view)
      end
    end
  
    children = this.collect_children(node)
    if children != null then
      i = 0
      while i < children.length do
        child = children[i]
        if not (child is Map) then
          assert(false, 'loadlayout child: expected Map and got ' .. type(child))
        end
        child_view = this.createView(child, view)
        view.addView(child_view)
        i = i + 1
      end
    end
  
    return view
  end

  function reset_views_to_defaults(key, view)
    default_node = this.default_nodes.get(key)
    debug("default_node for key $key is: $default_node")

    if java.instanceof(view, View) then
      // 1. Hard reset the most common properties you change dynamically
      view.setVisibility(0) // Default to visible
      
      if java.instanceof(view, TextView) then 
        view.setText("") 
      end
      if java.instanceof(view, ImageView) then 
        view.setImageDrawable(null) 
      end
      if java.instanceof(view, CompoundButton) then 
        view.setChecked(false) 
      end
      
      // 2. Re-apply the original static layout attributes
      if default_node != null then
        this.apply_attrs(view, default_node)
        this.apply_auto_attrs(view, default_node)
      end
    end
  end
  
  
  function bind_value(view, value)
    if value is String then
      if java.instanceof(view, ImageView) then
        this.apply_image(view, value)
      elif java.instanceof(view, TextView) then
        view.setText(value)
      end

    elif value is Bool then
      if java.instanceof(view, CompoundButton) then
        view.setChecked(value)
      end

    elif value is Number then
      if java.instanceof(view, ProgressBar) then
        view.setProgress(value)
      end

    elif value is Map then
      debug("value is map $value")
      this.apply_attrs(view, value)
      this.apply_auto_attrs(view, value)
    end
  end
  
  function bind(data)
    if not (data is Map) then
      return
    end
    
    keys = data.keys
    debug("debug mode in bind: $data")

    for key in keys do
      view = this.ids.get(key)
      // ADD THIS: Wipe old data and reset to original layout state first!
      this.reset_views_to_defaults(key, view)
      debug("debug mode in bind: $key -> $view, and id: ${this.ids}")

      if java.instanceof(view, View) then
        debug("debug mode in bind: $data")
        debug("visibility is: ${view.getVisibility()}")
        this.bind_value(view, data.get(key))
      end
    end
  end
end


function loadlayout(activity, node, data)
  if not (node is Map) then
    assert(false, 'loadlayout node: expected Map and got ' .. type(node))
  end

  ll = LoadLayout(activity)
  ll.setModule(java.mainModule)
  return ll.createView(node)
end
  
  
  