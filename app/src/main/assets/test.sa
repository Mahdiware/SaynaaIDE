function toast(msg)
  Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

// ================================
// COLORS
// ================================

WINDOW_BG      = 0xFF15171B
TITLE_BG       = 0xFF1E2126
ITEM_BG        = 0xFF24272D
ITEM_PRESSED   = 0xFF2C3037

TEXT           = 0xFFF2F3F5
TEXT_SECONDARY = 0xFF8D949E

ACCENT         = 0xFF5B8CFF
ACCENT_DARK    = 0xFF4779E8

GRIP           = 0xFFBDBDBD
GREEN          = 0xFF55D98A

function strokeBg(color, stroke, strokeColor, radius)
  bg = GradientDrawable()
  bg.setColor(color)
  bg.setCornerRadius(radius)
  bg.setStroke(stroke, strokeColor)
  return bg
end

