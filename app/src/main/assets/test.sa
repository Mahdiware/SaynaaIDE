ll = LoadLayout(activity)
ll.setModule(_module)

view = ll.createView(layout, View)



// ================================
// WINDOW MANAGER
// ================================

manager = activity.getWindowManager()

params = WindowManager.LayoutParams(
  500,
  600,
  0,
  0,
  WindowManager.LayoutParams.TYPE_APPLICATION,
  WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE |
  WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
  PixelFormat.TRANSLUCENT
)


params.gravity = Gravity.LEFT | Gravity.TOP

params.x = 100
params.y = 200


manager.addView(view, params)



// ================================
// STATE
// ================================

menuVisible = true

normalWidth = 500
normalHeight = 600

collapsedHeight = 100


// ================================
// collapse
// ================================

collapse.setOnClickListener({
  onClick: function(v)
    if not menuVisible then
      resize.setVisibility(View.VISIBLE)
      Features.setVisibility(View.VISIBLE)

      params.height = normalHeight
    else
      normalHeight = params.height
      resize.setVisibility(View.GONE)
      Features.setVisibility(View.GONE)

      params.height = collapsedHeight
    end

    manager.updateViewLayout(view, params)

    icon = menuVisible ? "ic_arrow_right.png" : "ic_arrow_down.png"
    collapse.setImageBitmap(BitmapFactory.decodeFile(saynaadir .. "/$icon"))

    menuVisible = not menuVisible
  end
})



// ================================
// DRAG HEADER
// ================================

downX = 0
downY = 0

startX = 0
startY = 0


header.setOnTouchListener(View.OnTouchListener({
  onTouch: function(v, event)
    actionValue = event.getAction()

    if actionValue == MotionEvent.ACTION_DOWN then

      downX = event.getRawX()
      downY = event.getRawY()

      startX = params.x
      startY = params.y

      return true
    elif actionValue == MotionEvent.ACTION_MOVE then

      dx = event.getRawX() - downX
      dy = event.getRawY() - downY

      params.x = startX + dx
      params.y = startY + dy

      manager.updateViewLayout(view, params)

      return true
    elif actionValue == MotionEvent.ACTION_UP then

      return true
    end

    return true
  end
}))



// ================================
// RESIZE
// ================================

resizeDownX = 0
resizeDownY = 0

resizeStartWidth = 0
resizeStartHeight = 0


resize.setOnTouchListener(View.OnTouchListener({
  onTouch: function(v, event)
    actionValue = event.getAction()

    if actionValue == MotionEvent.ACTION_DOWN then

      resizeDownX = event.getRawX()
      resizeDownY = event.getRawY()

      resizeStartWidth = params.width
      resizeStartHeight = params.height

      return true
    elif actionValue == MotionEvent.ACTION_MOVE then

      dx = event.getRawX() - resizeDownX
      dy = event.getRawY() - resizeDownY

      newWidth = resizeStartWidth + dx
      newHeight = resizeStartHeight + dy

      if newWidth < 320 then
        newWidth = 320
      end

      if newHeight < 400 then
        newHeight = 400
      end

      if newWidth > 900 then
        newWidth = 900
      end

      if newHeight > 1200 then
        newHeight = 1200
      end

      params.width = newWidth
      params.height = newHeight

      manager.updateViewLayout(view, params)

      return true
    elif actionValue == MotionEvent.ACTION_UP then

      return true
    end

    return true
  end
}))



// ================================
// FEATURE 1
// ================================

feature1.setOnCheckedChangeListener({
  onCheckedChanged: function(button, checked)
    if checked then
      status.setText("Feature 1 enabled")
    else
      status.setText("Ready")
    end
  end
})



// ================================
// FEATURE 2
// ================================

feature2.setOnCheckedChangeListener({
  onCheckedChanged: function(button, checked)
    if checked then
      status.setText("Feature 2 enabled")
    else
      status.setText("Ready")
    end
  end
})



// ================================
// ACTION
// ================================

action.setOnClickListener({
  onClick: function(v)
    status.setText("Action executed")
    toast("Action executed")
  end
})



// ================================
// CLOSE
// ================================

close.setOnClickListener({
  onClick: function(v)
    if view.getWindowToken() != null then
      manager.removeView(view)
    end
  end
})