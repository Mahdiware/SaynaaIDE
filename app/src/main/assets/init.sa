import java
import os
import package

from loadlayout import LoadLayout, loadlayout

saynaadir = java.saynaadir
package.path.append("$saynaadir")

# Classpath prefixes for fallback resolution
classpath = ["java.lang."]

function bindClass(name)
    return java.bindClass(name)
end

activity.setDebugMode(true)

package.searchers.append(function (name)
   # Support wildcard import: "java.util.*"
   if name.endswith(".*") then
      out = name.split("*")

      if out.length == 2 then
          if classpath.find(out[0]) == -1 then
              classpath.append(out[0])  # register package prefix
          end
          return true  # mark as handled
      end
   end
   
   // handle com.saynaa.R$style
   if name.find('$') != -1 then
     out = name.split('$')
     
     if out.length == 2 then
       result = pcall(bindClass, name)
       if result[0] then
         define(out[1], result[1])
         return true
       end
     end
   end

   # Try direct class bind: "java.lang.String"
   result = pcall(bindClass, name)
   if result[0] then
       return result[1]
   end

   return null  # not handled
end)

_module._missing = function(name)
    for path in classpath do
        result = pcall(bindClass, path + name)

        if result[0] and result[1] != null then
            define(name, result[1])  # cache
            return result[1]
        end
    end
end

function loadDex(path)
    return java.loadDex(path)
end
