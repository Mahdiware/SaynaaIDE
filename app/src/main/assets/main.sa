  {
    TextView,
    id: 'Title',
    text: 'Saynaa List Demo',
    textSize: '22sp',
    textStyle: 'bold',
    textColor: '#111111',
    layout_width: 'match_parent',
    layout_height: 'wrap_content',
    layout_marginBottom: '12dp'
  },

  {
    Button,
    id: 'nextpage',
    text: 'Next Page',
    layout_width: 'match_parent',
    layout_height: 'wrap_content',
    backgroundColor: '#03DAC5',
    textColor: '#000000',
    padding: '12dp',
    layout_marginBottom: '12dp'
  },

  {
    ListView,
    id: 'DemoList',
