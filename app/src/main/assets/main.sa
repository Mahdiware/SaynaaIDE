function assert_pcall(result, label)
	ok = result[0]
	if ok == null then
		ok = result[1]
	end
	if ok != true then
		err = result[1]
		if err == null then
			err = result[2]
		end
		assert(false, label + ': ' + String(err))
	end
end

loadDex("hello.dex")
import "com.saynaa.dextest.Hello"

msg = Hello.hello()
assert(msg == "Hello from dex", "Dex method return mismatch")

# testing getField and setField
result = pcall(function()
	pt = java.new('android.graphics.Point', 1, 2)
	java.setField(pt, 'x', 7)
	return java.getField(pt, 'x')
end)
assert_pcall(result, 'java.getField/setField failed')
assert(result[1] == 7, 'java.getField x mismatch')


# testing call
result = java.call(java.bindClass('java.lang.Math'), 'abs', -10)
assert(result == 10, 'Math.abs failed')

# testing call
result = java.call(java.bindClass('java.lang.Math'), 'max', 5, 8)
assert(result == 8, 'java.call static method failed')
result = java.call(result, 'toString')
assert(result == '8', 'java.call instance method failed')

