function toast(msg)
	Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

# requestPermissions(
#     new String[]{
#         Manifest.permission.READ_EXTERNAL_STORAGE,
#         Manifest.permission.WRITE_EXTERNAL_STORAGE
#     },
#     1001
# );

activity.requestPermissions(
    ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"],
    1001
);

function onRequestPermissionsResult(requestCode, permissions, grantResults)
  if requestCode == 1001 then
    if grantResults.length > 0 and grantResults[0] == PackageManager.PERMISSION_GRANTED then
      toast("Storage permissions granted")
    else
      toast("Storage permissions denied")
    end
  end
end

function assert_pcall(result, label)
	ok = result[0]
	if ok == null then
		ok = result[1]
	end
	if ok != true then
		err = result[1]
		if err == null then
			err = result[2]
		end
		assert(false, label + ': ' + str(err))
	end
end

loadDex("hello.dex")
import "com.saynaa.dextest.Hello"

msg = Hello.hello()
assert(msg == "Hello from dex", "Dex method return mismatch")


// new
assert(java.new("java.lang.String", "Hello from java.new!") == "Hello from java.new!", "java.new failed")

// create, length
testList = java.new('java.util.ArrayList')
testList.add('a')
testList.add('b')
assert(java.length(testList) == 2, 'java.length failed')

# testing new with multiple args and different types
LayoutParams = java.bindClass('android.widget.LinearLayout$LayoutParams')
params = java.new(LayoutParams, -1, -2)
assert(params != null, 'LayoutParams(width, height) failed')
java.testing(1, 2, 4, "hello", params, LinearLayout, TextView)


# testing getField and setField
result = pcall(function()
	pt = java.new('android.graphics.Point', 1, 2)
	java.setField(pt, 'x', 7)
	return java.getField(pt, 'x')
end)
assert_pcall(result, 'java.getField/setField failed')
assert(result[1] == 7, 'java.getField x mismatch')


# testing callStatic
result = java.callStatic('java.lang.Math','abs',-10)
assert(result == 10, 'Math.abs failed')

# testing call
result = java.call(java.bindClass('java.lang.Math'), 'max', 5, 8)
assert(result == 8, 'java.call static method failed')
result = java.call(result, 'toString')
assert(result == '8', 'java.call instance method failed')

DemoLayout = {
  LinearLayout,
  orientation: 'vertical',
  padding: '16dp',
  backgroundColor: '#EEF0F4',
  layout_width: 'match_parent',
  layout_height: 'match_parent',

  {
    TextView,
    id: 'Title',
    text: "Welcome to Saynaa!",
    textSize: '32sp',
    textStyle: 'bold',
    textColor: '#111111',
    layout_width: 'match_parent',
    layout_height: 'wrap_content',
    layout_marginBottom: '12dp'
  },

  {
    Button,
    id: 'nextpage',
    text: 'Next Page',
    layout_width: 'match_parent',
    layout_height: 'wrap_content',
    backgroundColor: '#03DAC5',
    textColor: '#000000',
    padding: '12dp',
    layout_marginBottom: '12dp'
  },

  load(java.saynaadir + "/listview.sa"),

  {
    ListView,
    id: 'DemoList',
    layout_width: 'match_parent',
    layout_height: 'match_parent',
    items: ['Item 1', 'Item 2', 'Item 3', 'Item 4', 'Item 5']
  }
}

