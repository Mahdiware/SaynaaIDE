import "android.widget.*"
import "android.view.*"
import "android.text.*"
import "android.os.*"
import "android.graphics.*"
import "com.android.saynaa.*"

function toast(msg)
	Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

/*
loadDex("hello.dex")
import "com.saynaa.dextest.Hello"

msg = Hello.hello()
toast(msg)
*/

DemoLayout = {
  LinearLayout,
  orientation: 'vertical',
  padding: '16dp',
  backgroundColor: '#EEF0F4',
  layout_width: 'match_parent',
  layout_height: 'match_parent',

  {
    TextView,
    id: 'Title',
    text: 'Saynaa List Demo',
    textSize: '22sp',
    textStyle: 'bold',
    textColor: '#111111',
    layout_width: 'match_parent',
    layout_height: 'wrap_content',
    layout_marginBottom: '12dp'
  },

  {
    Button,
    id: 'nextpage',
    text: 'Next Page',
    layout_width: 'match_parent',
    layout_height: 'wrap_content',
    backgroundColor: '#03DAC5',
    textColor: '#000000',
    padding: '12dp',
    layout_marginBottom: '12dp'
  },

  {
    ListView,
    id: 'DemoList',
    items: ['Mohamed - Software Engineer', 'Ahmed - Designer', 'Ali - Product Manager', 'Amina - QA Engineer'],
    layout_width: 'match_parent',
    layout_height: '240dp'
  }
}

assert(activity != null, 'activity is null')

root = loadlayout.loadlayout(_module, DemoLayout)
assert(root != null, 'loadlayout returned null')

function runfunc_test(arg1, arg2, arg3, arg4)
	return arg1 + arg2 + arg3 + arg4
end

assert(activity.runFunc("runfunc_test", 1, 2, 3, 40) == 46, "activity.runFunc return mismatch")

function onCreate(arg1)
  activity.setContentView(root)
  nextpage.setOnClickListener(View.OnClickListener({
    onClick: function(v)
      print('next page button clicked')
      activity.newActivity('main1')
    end
  }))
end
