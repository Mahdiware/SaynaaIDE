import java
import loadlayout

LinearLayout = java.bindClass('android.widget.LinearLayout')
TextView = java.bindClass('android.widget.TextView')
EditText = java.bindClass('android.widget.EditText')
Button = java.bindClass('android.widget.Button')
Switch = java.bindClass('android.widget.Switch')
Toast = java.bindClass('android.widget.Toast')
View = java.bindClass("android.view.View")


function print(msg)
  Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

DemoLayout = {
  type: LinearLayout,
  orientation: 'vertical',
  padding: 16,
  children: [
    {
      type: TextView,
      id: 'Title',
      text: 'Demo Form',
      textSize: '20sp',
      textStyle: 'bold',
      layout_gravity: 'center',
      layout_marginBottom: 10
    },
    {
      type: TextView,
      id: 'Description',
      text: 'This is a simple demo layout with a switch and button.',
      textSize: '14sp',
      layout_gravity: 'center',
      layout_marginBottom: 20
    },
    {
      type: EditText,
      id: 'NameInput',
      hint: 'Enter your name',
      layout_marginBottom: 10,
      singleLine: true
    },
    {
      type: Switch,
      id: 'EnableSwitch',
      text: 'Enable notifications',
      checked: false,
      layout_marginBottom: 20
    },
    {
      type: Button,
      id: 'SubmitButton',
      text: 'Submit',
      layout_gravity: 'center',
      backgroundColor: '#6200EE',
      textColor: '#FFFFFF',
      padding: 12,
      onClick: function(v)
        name = NameInput.getText()
        print('Hello ' + name)
        enabled = EnableSwitch.isChecked()
        Title.setText('Hello ' + name)
        Description.setText(enabled and 'Notifications enabled' or 'Notifications disabled')
      end
    },
    {
      type: Button,
      id: 'outsideCallButton',
      text: 'outside call button',
      layout_gravity: 'center',
      backgroundColor: '#03DAC5',
      textColor: '#000000',
      padding: 12,
    }

  ]
}

assert(activity != null, 'activity is null')

root = loadlayout.loadlayout(_module, DemoLayout)
assert(root != null, 'loadlayout returned null')
activity.setContentView(root)

assert(Title != null, 'Title view missing')
assert(Description != null, 'Description view missing')
assert(NameInput != null, 'NameInput view missing')
assert(EnableSwitch != null, 'EnableSwitch view missing')
assert(SubmitButton != null, 'SubmitButton view missing')
assert(outsideCallButton != null, 'outsideCallButton view missing')

outsideCallButton.setOnClickListener(View.OnClickListener({
  onClick: function(v)
    print('outside call button clicked')
  end
}))


